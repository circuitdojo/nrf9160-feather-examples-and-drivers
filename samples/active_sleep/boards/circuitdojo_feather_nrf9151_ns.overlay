/* Remap UART0 off P0.10/P0.11 to P0.23/P0.24 (UART1 pads). Console output
   shows up there if you tap during the boot decision window. */
&pinctrl {
	uart0_default_alt: uart0_default_alt {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 24)>,
					<NRF_PSEL(UART_RX, 0, 23)>;
		};
	};

	uart0_sleep_alt: uart0_sleep_alt {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 24)>,
					<NRF_PSEL(UART_RX, 0, 23)>;
			low-power-enable;
		};
	};

	/* Override SPI3 default pinctrl: split MISO into its own group
	   with a pull-down so it's clamped when the W25Q128 is in DPD
	   (MISO goes high-Z).  Prevents CMOS input-buffer shoot-through
	   on P0.5.  The weak pull is easily overdriven during active SPI
	   transactions so normal flash I/O is unaffected. */
	spi3_default: spi3_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 6)>,
			        <NRF_PSEL(SPIM_MOSI, 0, 7)>;
		};
		group2 {
			psels = <NRF_PSEL(SPIM_MISO, 0, 5)>;
			bias-pull-down;
		};
	};
};

&uart0 {
	pinctrl-0 = <&uart0_default_alt>;
	pinctrl-1 = <&uart0_sleep_alt>;
};

